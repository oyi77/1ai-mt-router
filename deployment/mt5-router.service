[Unit]
Description=MT5 Router Backend
After=network.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-mt-router/backend
Environment="DOCKER_HOST=unix:///var/run/docker.sock"
# Load secrets (JWT_SECRET, SECRET_KEY, ENCRYPTION_KEY, ...) from the repo's
# .env (generated by ./setup.sh) instead of hardcoding them here. The "-"
# prefix keeps the unit valid when .env does not exist yet. Note: for
# duplicates, EnvironmentFile takes precedence over Environment=, so ENV is
# governed by whatever setup.sh wrote to .env.
EnvironmentFile=-/home/openclaw/projects/1ai-mt-router/.env
Environment="ENV=production"
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/linuxbrew/.linuxbrew/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
