[Unit]
Description=MT5 Router Backend (1ai-mt-router)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-mt-router/backend
# Secrets (JWT_SECRET, SECRET_KEY, ENCRYPTION_KEY, ...) come from the repo .env
# (generated by ./setup.sh). The "-" prefix keeps the unit valid if it is absent.
EnvironmentFile=-/home/openclaw/projects/1ai-mt-router/.env
Environment="ENV=production"
Environment="HOST=127.0.0.1"
Environment="PORT=8081"
# Bound to loopback:8081 to avoid colliding with 1ai-trade-cex (127.0.0.1:8080).
ExecStart=/home/openclaw/projects/1ai-mt-router/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8081
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
