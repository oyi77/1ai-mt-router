# MT5 Router SaaS Configuration
# Copy to `.env` and adjust. Every variable below maps 1:1 to a field on
# `backend/app/config.py::Settings`. Variables not present here are ignored
# (Settings uses extra="ignore").
#
# Legend:
#   [prod]  Required when ENV=production (missing/weak values fail startup).
#   [opt]   Optional — feature is disabled when empty.
#   [dev]   Dev/test default — safe to leave as-is for local runs.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# [dev] Runtime environment: development | test | production.
#       Production enables fail-fast secret validation at startup.
ENV=development
APP_NAME=MT5 Router
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8080

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# [prod] JWT signing secret. Random string >= 32 chars.
JWT_SECRET=change-this-to-a-secure-random-string-64-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
# [prod] General-purpose server secret (future admin/session features).
SECRET_KEY=
# [prod] Fernet key used to encrypt secrets at rest (2FA seeds, webhook
#       targets, SSH keys). Generate one with:
#         python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#       Empty in dev -> encryption service uses an ephemeral per-process key
#       (data is not stable across restarts; fine for local development).
#       Rotation: generate a new key with the command above, update this var
#       (and deployment/mt5-router.service), then restart. NOTE: rotating
#       invalidates previously encrypted secrets at rest (2FA seeds, webhook
#       targets, SSH keys) — re-enter them after rotation.
ENCRYPTION_KEY=3ZXXm45zcXpnoigGfMIwJxox_q5uUd30W1VoLpXqNTk=

# ---------------------------------------------------------------------------
# Admin bootstrap seed (used when creating the initial admin user)
# ---------------------------------------------------------------------------
# [prod] Initial admin account. The seed must NEVER hardcode a default
#        password — in production set a strong, unique ADMIN_PASSWORD.
#        Empty ADMIN_PASSWORD -> seed disabled / not created.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mt5router.local
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# [dev] Comma-separated origin list. Use "*" only for development.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# [dev] SQLite is the default for local runs.
DATABASE_URL=sqlite:///./data/mt5router.db
# Production (PostgreSQL) — keep the same env-var name docker-compose.prod.yml
# interpolates, e.g.:
#   DATABASE_URL=postgresql://mt5router:${DB_PASSWORD}@postgres:5432/mt5router
# [prod] DB password. Required (and must not be a weak placeholder like
#       "changeme") when DATABASE_URL is a postgres:// URL.
DB_PASSWORD=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Docker / instance orchestration
# ---------------------------------------------------------------------------
DOCKER_SOCKET=unix:///var/run/docker.sock
MT5_IMAGE=lprett/mt5linux:mt5-installed
MT5_NETWORK=bridge
MT5_RPYC_PORT=18812
MT5_VNC_PORT=6081
# "docker" (local socket) or "remote" (rootless/remote docker context).
# Expose the docker.sock mount only when this is "docker".
INSTANCE_ORCHESTRATION=docker

# ---------------------------------------------------------------------------
# Metrics / alerts
# ---------------------------------------------------------------------------
METRICS_INTERVAL=10
ALERT_COOLDOWN=300

# ---------------------------------------------------------------------------
# Rate limiting / API keys
# ---------------------------------------------------------------------------
API_KEY_PREFIX=mtr_
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# Stripe (billing; [opt] — empty disables billing init)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=

# ---------------------------------------------------------------------------
# NOWPayments (crypto payments; [opt])
# ---------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# ---------------------------------------------------------------------------
# Email / SMTP ([opt] — if SMTP_HOST is set, SMTP_USER, SMTP_PASSWORD and
# FROM_EMAIL become required in production)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
BASE_URL=https://mt-oc.aitradepulse.com

# ---------------------------------------------------------------------------
# Redis ([opt] — used for rate limiting / queues when present)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
